<devicesets>
<deviceset name="HR871150C" prefix="J">
<description>HanRun HR871150C。チップ側 TD+ (P1)・TD− (P2)・CT (P3、送受の中点タップを内部で共通)・RD+ (P4)・RD− (P5)。ケーブル側の中点タップ VC1+ (P7、J1/J2)・VC1− (P8、J3/J6)・VC2+ (P9、J4/J5)・VC2− (P10、J7/J8)、57 V・350 mA/タップ。黄 LED (11 アノード、12 カソード)、緑 LED (13 アノード、14 カソード)、シールド。Bob Smith 終端 (22 nF + 75 Ω × 4) と 1000 pF 2 kV (シールド) を内蔵。LED の極性 (どちらがアノードか) はデータシートの図で確かめること。</description>
<gates>
<gate name="G$1" symbol="RJ45_POE_MAGJACK" x="0" y="0"/>
</gates>
<devices>
<device name="" package="RJ45-TH_HR871150C">
<connects>
<connect gate="G$1" pin="TD+" pad="1"/>
<connect gate="G$1" pin="TD-" pad="2"/>

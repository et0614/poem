<connect gate="G$1" pin="VC1-" pad="8"/>
<connect gate="G$1" pin="VC2+" pad="9"/>
<connect gate="G$1" pin="VC2-" pad="10"/>
<connect gate="G$1" pin="YEL_A" pad="11"/>
<connect gate="G$1" pin="YEL_K" pad="12"/>
<connect gate="G$1" pin="GRN_A" pad="13"/>
<connect gate="G$1" pin="GRN_K" pad="14"/>
<connect gate="G$1" pin="SHIELD" pad="SH1 SH2"/>
</connects>

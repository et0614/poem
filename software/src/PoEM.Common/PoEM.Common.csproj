<Project Sdk="Microsoft.NET.Sdk">

  <!-- PoEMServer と PoEM Link アプリで共通に使う表と計算 (機種名・単位・状態の名前、Device ID)。
       機種を足すときはここだけを直す。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PoEM.Common</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
